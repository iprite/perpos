# คัดลอกเป็น terraform.tfvars แล้วใส่ค่าจริง — ห้าม commit ไฟล์ terraform.tfvars
hcloud_token   = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
mail_hostname  = "mail.perpos.ai"
server_type    = "cpx11"

# IP ที่ให้ SSH เข้าได้ — ระบุให้แคบที่สุดเท่าที่ทำได้
ssh_allowed_ips = ["0.0.0.0/0", "::/0"]
