# PERPOS VPS — reverse proxy ทุกโดเมน → Next.js instance ตาม port
# ทุกโดเมนเว็บอยู่หลัง Cloudflare proxy (เมฆส้ม) → ใช้ DNS-01 ออกใบรับรอง origin
# เมล: mailserver.perpos.ai / login.perpos.ai = Cloudflare เมฆเทาเสมอ (ห้าม proxy — SMTP/IMAP พัง)
# Caddy ถือ 443 ของสองชื่อนี้แล้ว proxy → Stalwart :8080 (HTTP ธรรมดา) เพราะบนเครื่องเดียว
# port 443 มีได้ตัวเดียว · Stalwart ถือเองแค่ port เมล (25/465/587/993/995/4190) ด้วยใบรับรองของมันเอง

{
	email admin@perpos.ai
	servers {
		# หลัง Cloudflare proxy (เมฆส้ม): เชื่อ X-Forwarded-For / CF-Connecting-IP จาก IP ของ CF เท่านั้น
		# → แอปเห็น IP ผู้ใช้จริงใน x-forwarded-for (audit log / rate-limit ใช้ header นี้อยู่)
		# ห้ามเชื่อจากทุกที่ — ไม่งั้นใครก็ปลอม IP ได้ (แต่ตอนนี้ port 443 เปิดตรงอยู่ด้วย ดูข้อ ufw)
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
	}
}

(cf_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# access log JSON ไป stdout (docker compose logs caddy) — client_ip = IP ผู้ใช้จริงหลัง trusted_proxies
	log {
		output stdout
		format json
	}
}

# perpos — โปรเจกต์เดียวเสิร์ฟ 2 โดเมน (middleware ของแอปแยกพฤติกรรมตาม host เอง)
# blue/green (zero-downtime deploy): ปกติรันสีเดียว อีกสี stopped (DNS ไม่ resolve = unhealthy เฉย ๆ)
# lb_policy first = ส่งเข้าตัวแรกที่ healthy เสมอ (blue ก่อน) · health เช็ค /api/health ทุก 3 วิ —
# สคริปต์ deploy (switch-app.sh) แตะ /tmp/drain ให้สีเก่าตอบ 503 · exapp/riekchang ใช้ท่าเดียวกัน → หลุดจาก pool ก่อนถูก stop
# lb_try_duration = ถ้า dial ไม่ติด (สีนั้นเพิ่งดับ) ลองตัวถัดไปแทนที่จะตอบ 502 ทันที
app.perpos.ai, mail.perpos.ai {
	import cf_tls
	encode zstd gzip
	reverse_proxy perpos-blue:3005 perpos-green:3005 {
		lb_policy first
		lb_try_duration 20s
		lb_try_interval 250ms
		health_uri /api/health
		health_interval 3s
		health_timeout 2s
		fail_duration 10s
		max_fails 1
	}
}

(exapp_upstream) {
	reverse_proxy exapp-blue:3006 exapp-green:3006 {
		lb_policy first
		lb_try_duration 20s
		lb_try_interval 250ms
		health_uri /api/health
		health_interval 3s
		health_timeout 2s
		fail_duration 10s
		max_fails 1
	}
}

# โดเมนที่ยังไม่มี container รองรับ ห้ามเปิดค้างไว้ — Caddy จะไล่ขอใบรับรองซ้ำจนโดน ACME rate limit
app.exworker.co.th {
	import cf_tls
	encode zstd gzip

	# บ้านของหน้าแชทย้ายไป chat.exworker.co.th แล้ว — URL เก่ายังใช้ได้ (โฆษณา/ลิงก์ที่ส่งกันไปแล้ว)
	# 302 ไม่ใช่ 301: เบราว์เซอร์จำ 301 ถาวร ย้ายกลับไม่ได้ · ต้องพา query string ไปด้วย ไม่งั้น gclid หาย
	# ⚠️ เฉพาะ path ของหน้าเว็บ — ห้ามแตะ /api/public/chat (หน้าแชทกับ smoke test ยิงตรงเข้า API)
	@chat_moved_q {
		path /public/chat
		expression {query} != ""
	}
	redir @chat_moved_q https://chat.exworker.co.th/?{query} 302
	redir /public/chat https://chat.exworker.co.th/ 302

	import exapp_upstream
}

# chat.exworker.co.th — หน้าแชทน้องเอ็กซ์ (ปลายทางของโฆษณา) อยู่บน instance exapp ตัวเดิม
# ทำไมแยกชื่อ: URL ที่พูดในโฆษณา/สื่อได้สั้น ๆ + วัดผลง่าย (โดเมนเดียว = ทราฟฟิกโฆษณาล้วน)
# `rewrite /` = เปิด chat.exworker.co.th เฉย ๆ เจอหน้าแชทเลย (query string gclid/utm_* ติดไปเอง)
# allowlist: โดเมนนี้ต้องเสิร์ฟ "เฉพาะ" หน้าแชท — ไม่งั้น dashboard/หน้าล็อกอินของทีมงาน
# โผล่บนโดเมนที่เอาไปยิงแอด (ทั้งเรื่องความปลอดภัยและ SEO) · path อื่นเด้งกลับ app.exworker.co.th
# ⚠️ Turnstile site key ต้องอนุญาต hostname นี้ด้วย ไม่งั้นแชทตอบ 403 ทุกข้อความ
chat.exworker.co.th {
	import cf_tls
	encode zstd gzip
	rewrite / /public/chat

	@chat path /public/chat /public/chat/* /api/public/chat /api/public/chat/* /api/auth/line/callback /_next/* /favicon.ico
	handle @chat {
		import exapp_upstream
	}
	handle {
		redir https://app.exworker.co.th{uri} 302
	}
}

app.riekchang.com {
	import cf_tls
	encode zstd gzip
	reverse_proxy riekchang-blue:3007 riekchang-green:3007 {
		lb_policy first
		lb_try_duration 20s
		lb_try_interval 250ms
		health_uri /api/health
		health_interval 3s
		health_timeout 2s
		fail_duration 10s
		max_fails 1
	}
}

# ── เมล (เฟส 2, 2026-08-19) — Stalwart อยู่บน host (native systemd) ไม่ใช่ container ──
# host.docker.internal = host จาก container (ต้อง extra_hosts ใน compose)
# ⚠️ ห้ามใส่ mailserver/login ในเมฆส้ม — DNS ต้องชี้ IP จริงเสมอ
# ทั้ง 6 ชื่อ × 2 โดเมน = สิ่งที่ Stalwart เคยเสิร์ฟเองบน 443 (OAuth/JMAP/MTA-STS policy/autoconfig)
mailserver.perpos.ai, login.perpos.ai, mta-sts.perpos.ai, autoconfig.perpos.ai, autodiscover.perpos.ai, ua-auto-config.perpos.ai, mta-sts.exworker.co.th, autoconfig.exworker.co.th, autodiscover.exworker.co.th, ua-auto-config.exworker.co.th {
	import cf_tls
	encode zstd gzip
	reverse_proxy host.docker.internal:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}
