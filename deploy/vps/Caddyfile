# PERPOS VPS — reverse proxy ทุกโดเมน → Next.js instance ตาม port
# ทุกโดเมนเว็บอยู่หลัง Cloudflare proxy (เมฆส้ม) → ใช้ DNS-01 ออกใบรับรอง origin
# เมล: mailserver.perpos.ai / login.perpos.ai = Cloudflare เมฆเทาเสมอ (ห้าม proxy — SMTP/IMAP พัง)
# Caddy ถือ 443 ของสองชื่อนี้แล้ว proxy → Stalwart :8080 (HTTP ธรรมดา) เพราะบนเครื่องเดียว
# port 443 มีได้ตัวเดียว · Stalwart ถือเองแค่ port เมล (25/465/587/993/995/4190) ด้วยใบรับรองของมันเอง

{
	email admin@perpos.ai
	servers {
		# หลัง Cloudflare proxy (เมฆส้ม): เชื่อ X-Forwarded-For / CF-Connecting-IP จาก IP ของ CF เท่านั้น
		# → แอปเห็น IP ผู้ใช้จริงใน x-forwarded-for (audit log / rate-limit ใช้ header นี้อยู่)
		# ห้ามเชื่อจากทุกที่ — ไม่งั้นใครก็ปลอม IP ได้ (แต่ตอนนี้ port 443 เปิดตรงอยู่ด้วย ดูข้อ ufw)
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
	}
}

(cf_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# access log JSON ไป stdout (docker compose logs caddy) — client_ip = IP ผู้ใช้จริงหลัง trusted_proxies
	log {
		output stdout
		format json
	}
}

# perpos — โปรเจกต์เดียวเสิร์ฟ 2 โดเมน (middleware ของแอปแยกพฤติกรรมตาม host เอง)
app.perpos.ai, mail.perpos.ai {
	import cf_tls
	encode zstd gzip
	reverse_proxy perpos:3005
}

# โดเมนที่ยังไม่มี container รองรับ ห้ามเปิดค้างไว้ — Caddy จะไล่ขอใบรับรองซ้ำจนโดน ACME rate limit
app.exworker.co.th {
	import cf_tls
	encode zstd gzip
	reverse_proxy exapp:3006
}

app.riekchang.com {
	import cf_tls
	encode zstd gzip
	reverse_proxy riekchang:3007
}

# ── เมล (เฟส 2, 2026-08-19) — Stalwart อยู่บน host (native systemd) ไม่ใช่ container ──
# host.docker.internal = host จาก container (ต้อง extra_hosts ใน compose)
# ⚠️ ห้ามใส่ mailserver/login ในเมฆส้ม — DNS ต้องชี้ IP จริงเสมอ
# ทั้ง 6 ชื่อ × 2 โดเมน = สิ่งที่ Stalwart เคยเสิร์ฟเองบน 443 (OAuth/JMAP/MTA-STS policy/autoconfig)
mailserver.perpos.ai, login.perpos.ai, mta-sts.perpos.ai, autoconfig.perpos.ai, autodiscover.perpos.ai, ua-auto-config.perpos.ai, mta-sts.exworker.co.th, autoconfig.exworker.co.th, autodiscover.exworker.co.th, ua-auto-config.exworker.co.th {
	import cf_tls
	encode zstd gzip
	reverse_proxy host.docker.internal:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}
